@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 2
skinparam ArrowColor #1E5631
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1E5631
  BorderThickness 1.3
  HeaderBackgroundColor #E2F0E6
  FontStyle bold
  AttributeFontColor #222222
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #EEF7EE
  BorderColor #4E8F5F
  FontSize 11
}
skinparam stereotypeCBackgroundColor #E8EEF7
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
  FontColor #444444
}
abstract class Logistica {
  +planificarEntrega(km: double): String
  #{abstract} crearTransporte(): Transporte
}
class LogisticaTerrestre {
  #crearTransporte(): Transporte
}
class LogisticaMaritima {
  #crearTransporte(): Transporte
}
class LogisticaAerea {
  #crearTransporte(): Transporte
}
interface Transporte {
  +nombre(): String
  +costoPorKm(): double
  +despachar(): String
}
class Camion
class Barco
class Dron
Logistica <|-- LogisticaTerrestre
Logistica <|-- LogisticaMaritima
Logistica <|-- LogisticaAerea
Logistica ..> Transporte : usa
Transporte <|.. Camion
Transporte <|.. Barco
Transporte <|.. Dron
LogisticaTerrestre ..> Camion : <<crea>>
LogisticaMaritima ..> Barco : <<crea>>
LogisticaAerea ..> Dron : <<crea>>
@enduml
