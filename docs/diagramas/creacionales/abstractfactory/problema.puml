@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 2
skinparam ArrowColor #7A2E2E
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #7A2E2E
  BorderThickness 1.3
  HeaderBackgroundColor #F7E3E1
  FontStyle bold
  AttributeFontColor #222222
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #FFF1F0
  BorderColor #C0504D
  FontSize 11
}
skinparam stereotypeCBackgroundColor #E8EEF7
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
  FontColor #444444
}
class PantallaPago {
  -tema: String
  +PantallaPago(tema: String)
  +dibujar(): String
}
class BotonClaro {
  +render(texto: String): String
}
class BotonOscuro {
  +render(texto: String): String
}
class CampoTextoClaro {
  +render(etiqueta: String): String
}
class CampoTextoOscuro {
  +render(etiqueta: String): String
}
PantallaPago ..> BotonClaro : <<crea>>
PantallaPago ..> BotonOscuro : <<crea>>
PantallaPago ..> CampoTextoClaro : <<crea>>
PantallaPago ..> CampoTextoOscuro : <<crea>>
note top of PantallaPago
  Deuda: if/else por tema en cada
  creación; depende de 4 clases concretas;
  puede mezclar familias.
end note
@enduml
