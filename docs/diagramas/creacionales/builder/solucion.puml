@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 2
skinparam ArrowColor #1E5631
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1E5631
  BorderThickness 1.3
  HeaderBackgroundColor #E2F0E6
  FontStyle bold
  AttributeFontColor #222222
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #EEF7EE
  BorderColor #4E8F5F
  FontSize 11
}
skinparam stereotypeCBackgroundColor #E8EEF7
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
  FontColor #444444
}
class DirectorReporteVentas {
  +construir(b: ConstructorReporte, titulo: String,
  ventas: List<Venta>): void
}
interface ConstructorReporte {
  +titulo(texto: String): void
  +fila(producto: String, total: double): void
  +pie(texto: String): void
}
class ConstructorHtml {
  -html: StringBuilder
  +resultado(): String
}
class ConstructorTexto {
  -lineas: List<String>
  +resultado(): String
}
class Venta <<record>> {
  +producto: String
  +total: double
}
DirectorReporteVentas ..> ConstructorReporte : usa
DirectorReporteVentas ..> Venta
ConstructorReporte <|.. ConstructorHtml
ConstructorReporte <|.. ConstructorTexto
@enduml
