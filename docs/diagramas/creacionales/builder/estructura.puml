@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 2
skinparam ArrowColor #2F4A6D
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #2F4A6D
  BorderThickness 1.3
  HeaderBackgroundColor #E6EDF6
  FontStyle bold
  AttributeFontColor #222222
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #FDFBEA
  BorderColor #B9A64B
  FontSize 11
}
skinparam stereotypeCBackgroundColor #E8EEF7
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
  FontColor #444444
}
class Director {
  -builder: Builder
  +construir(): void
}
interface Builder {
  +construirParteA(): void
  +construirParteB(): void
}
class ConcreteBuilder1 {
  +construirParteA(): void
  +construirParteB(): void
  +getResultado(): Producto1
}
class ConcreteBuilder2 {
  +construirParteA(): void
  +construirParteB(): void
  +getResultado(): Producto2
}
class Producto1
class Producto2
Director o--> Builder
Builder <|.. ConcreteBuilder1
Builder <|.. ConcreteBuilder2
ConcreteBuilder1 ..> Producto1 : <<crea>>
ConcreteBuilder2 ..> Producto2 : <<crea>>
note left of Director
  for (parte : estructura)
    builder.construirParte(...)
end note
@enduml
