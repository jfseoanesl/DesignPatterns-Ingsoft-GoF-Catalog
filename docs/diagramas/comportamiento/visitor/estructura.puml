@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 2
skinparam ArrowColor #2F4A6D
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #2F4A6D
  BorderThickness 1.3
  HeaderBackgroundColor #E6EDF6
  FontStyle bold
  AttributeFontColor #222222
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #FDFBEA
  BorderColor #B9A64B
  FontSize 11
}
skinparam stereotypeCBackgroundColor #E8EEF7
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
  FontColor #444444
}
class Cliente
interface Visitor {
  +visitarA(e: ConcreteElementA): void
  +visitarB(e: ConcreteElementB): void
}
class ConcreteVisitor1
class ConcreteVisitor2
interface Element {
  +aceptar(v: Visitor): void
}
class ConcreteElementA {
  +aceptar(v: Visitor): void
  +operacionA(): void
}
class ConcreteElementB {
  +aceptar(v: Visitor): void
  +operacionB(): void
}
class ObjectStructure
Cliente --> Visitor
Cliente --> ObjectStructure
Visitor <|.. ConcreteVisitor1
Visitor <|.. ConcreteVisitor2
ObjectStructure o--> "*" Element
Element <|.. ConcreteElementA
Element <|.. ConcreteElementB
note bottom of ConcreteElementA
  v.visitarA(this)
end note
@enduml
