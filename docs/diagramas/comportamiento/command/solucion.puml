@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 2
skinparam ArrowColor #1E5631
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1E5631
  BorderThickness 1.3
  HeaderBackgroundColor #E2F0E6
  FontStyle bold
  AttributeFontColor #222222
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #EEF7EE
  BorderColor #4E8F5F
  FontSize 11
}
skinparam stereotypeCBackgroundColor #E8EEF7
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
  FontColor #444444
}
interface Comando {
  +ejecutar(): void
  +deshacer(): void
}
class ComandoEscribir {
  -texto: String
}
class ComandoBorrar {
  -n: int
  -borrado: String
}
class ComandoMayusculas {
  -anterior: String
}
class Documento <<receiver>> {
  +insertar(t: String): void
  +borrarUltimos(n: int): String
  +reemplazar(t: String): String
}
class Historial <<invoker>> {
  -deshacer: Deque<Comando>
  -rehacer: Deque<Comando>
  +ejecutar(c: Comando): void
  +deshacer(): void
  +rehacer(): void
}
class Boton {
  -comando: Supplier<Comando>
  +clic(): void
}
Comando <|.. ComandoEscribir
Comando <|.. ComandoBorrar
Comando <|.. ComandoMayusculas
ComandoEscribir --> Documento
ComandoBorrar --> Documento
ComandoMayusculas --> Documento
Historial o--> "*" Comando
Boton --> Historial
@enduml
