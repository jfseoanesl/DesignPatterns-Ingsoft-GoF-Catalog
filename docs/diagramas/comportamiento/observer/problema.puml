@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 2
skinparam ArrowColor #7A2E2E
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #7A2E2E
  BorderThickness 1.3
  HeaderBackgroundColor #F7E3E1
  FontStyle bold
  AttributeFontColor #222222
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #FFF1F0
  BorderColor #C0504D
  FontSize 11
}
skinparam stereotypeCBackgroundColor #E8EEF7
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
  FontColor #444444
}
class EstacionMeteorologica {
  -pantalla: PantallaActual
  -estadisticas: PanelEstadisticas
  -alerta: AlertaCalor
  +registrar(temp: double, humedad: double): void
}
class PantallaActual {
  +mostrar(t: double, h: double): void
}
class PanelEstadisticas {
  +actualizar(t: double): void
}
class AlertaCalor {
  +revisar(t: double): void
}
EstacionMeteorologica --> PantallaActual
EstacionMeteorologica --> PanelEstadisticas
EstacionMeteorologica --> AlertaCalor
note top of EstacionMeteorologica
  Deuda: conoce las vistas concretas;
  agregar una vista = modificar la estación.
end note
@enduml
