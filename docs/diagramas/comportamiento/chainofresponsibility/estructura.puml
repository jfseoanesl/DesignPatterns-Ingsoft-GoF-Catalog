@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 2
skinparam ArrowColor #2F4A6D
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #2F4A6D
  BorderThickness 1.3
  HeaderBackgroundColor #E6EDF6
  FontStyle bold
  AttributeFontColor #222222
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #FDFBEA
  BorderColor #B9A64B
  FontSize 11
}
skinparam stereotypeCBackgroundColor #E8EEF7
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
  FontColor #444444
}
class Cliente
abstract class Handler {
  #sucesor: Handler
  +manejarPeticion(): void
}
class ConcreteHandler1 {
  +manejarPeticion(): void
}
class ConcreteHandler2 {
  +manejarPeticion(): void
}
Cliente --> Handler
Handler o--> "0..1" Handler : sucesor
Handler <|-- ConcreteHandler1
Handler <|-- ConcreteHandler2
note right of Handler
  if (puedoManejar) manejar
  else sucesor.manejarPeticion()
end note
@enduml
