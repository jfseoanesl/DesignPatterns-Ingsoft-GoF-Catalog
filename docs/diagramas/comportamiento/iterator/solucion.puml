@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 2
skinparam ArrowColor #1E5631
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1E5631
  BorderThickness 1.3
  HeaderBackgroundColor #E2F0E6
  FontStyle bold
  AttributeFontColor #222222
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #EEF7EE
  BorderColor #4E8F5F
  FontSize 11
}
skinparam stereotypeCBackgroundColor #E8EEF7
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
  FontColor #444444
}
interface "Iterable<Cancion>" as Iterable {
  +iterator(): Iterator<Cancion>
}
interface "Iterator<Cancion>" as Iterator {
  +hasNext(): boolean
  +next(): Cancion
}
class ListaReproduccion {
  -canciones: List<Cancion>
  +agregar(c: Cancion): void
  +iterator(): Iterator<Cancion>
  +aleatorio(semilla: long): Iterable<Cancion>
  +favoritas(): Iterable<Cancion>
}
class IteradorSecuencial <<private>> {
  -pos: int
}
class IteradorAleatorio <<private>> {
  -orden: int[]
  -pos: int
}
class IteradorFavoritas <<private>> {
  -pos: int
  -avanzar(): void
}
class Cancion <<record>>
class Reproductor {
  +reproducir(canciones: Iterable<Cancion>): String
}
Iterable <|.. ListaReproduccion
Iterator <|.. IteradorSecuencial
Iterator <|.. IteradorAleatorio
Iterator <|.. IteradorFavoritas
ListaReproduccion +-- IteradorSecuencial
ListaReproduccion +-- IteradorAleatorio
ListaReproduccion +-- IteradorFavoritas
ListaReproduccion o--> "*" Cancion
Reproductor ..> Iterable
@enduml
