@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 2
skinparam ArrowColor #1E5631
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1E5631
  BorderThickness 1.3
  HeaderBackgroundColor #E2F0E6
  FontStyle bold
  AttributeFontColor #222222
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #EEF7EE
  BorderColor #4E8F5F
  FontSize 11
}
skinparam stereotypeCBackgroundColor #E8EEF7
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
  FontColor #444444
}
class Pedido <<context>> {
  -estado: EstadoPedido
  -historial: List<String>
  +pagar(): void
  +enviar(): void
  +entregar(): void
  +cancelar(): void
  ~transicionar(nuevo: EstadoPedido): void
}
interface EstadoPedido {
  +nombre(): String
  +pagar(p: Pedido): void
  +enviar(p: Pedido): void
  +entregar(p: Pedido): void
  +cancelar(p: Pedido): void
}
class Pendiente
class Pagado
class Enviado
class Entregado
class Cancelado
Pedido o--> "1" EstadoPedido : estado
EstadoPedido <|.. Pendiente
EstadoPedido <|.. Pagado
EstadoPedido <|.. Enviado
EstadoPedido <|.. Entregado
EstadoPedido <|.. Cancelado
Pendiente ..> Pagado : pagar
Pendiente ..> Cancelado : cancelar
Pagado ..> Enviado : enviar
Pagado ..> Cancelado : cancelar
Enviado ..> Entregado : entregar
@enduml
