@startuml
skinparam dpi 170
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam nodesep 45
skinparam ranksep 55
skinparam padding 2
skinparam ArrowColor #1E5631
skinparam ArrowThickness 1.1
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1E5631
  BorderThickness 1.3
  HeaderBackgroundColor #E2F0E6
  FontStyle bold
  AttributeFontColor #222222
  StereotypeFontColor #555555
}
skinparam note {
  BackgroundColor #EEF7EE
  BorderColor #4E8F5F
  FontSize 11
}
skinparam stereotypeCBackgroundColor #E8EEF7
skinparam stereotypeIBackgroundColor #FFF4D6
skinparam stereotypeABackgroundColor #E3F1E8
hide empty members
skinparam package {
  BorderColor #8A8A8A
  FontStyle normal
  FontColor #444444
}
class ControladorCompraWeb
class ControladorCompraMovil
class FachadaCompras {
  +comprar(pedido: SolicitudCompra): Resultado
}
package "Subsistema de compras" {
  class Inventario {
    +reservar(sku: String, cant: int): boolean
    +liberar(sku: String, cant: int): void
  }
  class Pagos {
    +cobrar(tarjeta: String, valor: long): boolean
  }
  class Envios {
    +programar(cliente: String, sku: String): String
  }
  class Facturacion {
    +emitir(cliente: String, valor: long): String
  }
  class Notificador {
    +enviar(cliente: String, msg: String): void
  }
}
ControladorCompraWeb --> FachadaCompras
ControladorCompraMovil --> FachadaCompras
FachadaCompras --> Inventario
FachadaCompras --> Pagos
FachadaCompras --> Envios
FachadaCompras --> Facturacion
FachadaCompras --> Notificador
@enduml
